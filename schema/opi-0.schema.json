{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpictureintelligence.org/schema/opi-0.schema.json",
  "title": "Open Picture Intelligence manifest, format version 0",
  "description": "The envelope of a .opi sidecar manifest (SPEC §5, §6, §7, §8). Every known key is typed and constrained; every object permits additional properties so readers stay forward-compatible (§5.3). Facet contents are open in version 0 — see facets-0.schema.json for the proposed vocabulary.",
  "type": "object",
  "required": ["opi", "profile", "media_binding"],
  "additionalProperties": true,
  "properties": {
    "opi": {
      "description": "Format major version; MUST be the first key (§5.2). This schema is for version 0.",
      "type": "integer",
      "const": 0
    },
    "profile": {
      "description": "MUST equal the profile derived from the members (§3.3).",
      "type": "string",
      "enum": ["core", "full"]
    },
    "generator": {
      "description": "Informative: the software that wrote the manifest (§5.1).",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generated_at": {
      "description": "Informative: when the manifest was written. RFC 3339 date-time.",
      "$ref": "#/$defs/datetime"
    },
    "$schema": {
      "description": "Informative hint for editors. Readers MUST NOT fetch it.",
      "type": "string"
    },
    "media_binding": { "$ref": "#/$defs/media_binding" },
    "machine_intelligence": {
      "description": "Runs (§7). Absent is read as empty.",
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    },
    "editorial_annotations": { "$ref": "#/$defs/editorial_annotations" }
  },
  "$defs": {
    "sha256": {
      "description": "SHA-256 of a whole file, 64 lowercase hex characters (§6.2).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "xxh64be": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "datetime": {
      "description": "RFC 3339 date-time: YYYY-MM-DDTHH:MM:SS[.frac](Z|±HH:MM).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [ { "$ref": "#/$defs/datetime" }, { "type": "null" } ]
    },
    "rational": {
      "description": "A frame rate in lowest terms (§6A.1). Reduction is checked by the validator, not the schema.",
      "type": "object",
      "required": ["num", "den"],
      "additionalProperties": true,
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "timecode": {
      "description": "§6A.2.",
      "type": "object",
      "required": ["rate", "drop_frame"],
      "additionalProperties": true,
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}[:;][0-9]{2,3}$" },
        "recorded": { "type": ["string", "null"] },
        "rate": { "$ref": "#/$defs/rational" },
        "drop_frame": { "type": "boolean" },
        "label": { "type": "string" }
      }
    },
    "span": {
      "description": "A time range (§6A.3). Consistency between frames, seconds and timecode is checked by the validator.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "frame_in": { "type": "integer", "minimum": 0 },
        "frame_out": { "type": "integer", "minimum": 1 },
        "t_start_s": { "type": ["number", "null"], "minimum": 0 },
        "t_end_s": { "type": ["number", "null"], "minimum": 0 },
        "tc_in": { "type": "string" },
        "tc_out": { "type": "string" },
        "frames": { "type": "integer", "minimum": 1 }
      }
    },
    "file": {
      "description": "One file carrying the asset (§6.2).",
      "type": "object",
      "required": ["name", "sha256"],
      "additionalProperties": true,
      "properties": {
        "role": { "type": "string", "enum": ["original", "proxy", "transcode", "audio", "other"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" },
        "path": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "xxh64be": { "$ref": "#/$defs/xxh64be" },
        "container": { "type": ["string", "null"] },
        "video_codec": { "type": ["string", "null"] },
        "audio_codec": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "fps": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "original_file": {
      "description": "A files[] entry that counts as the original: role 'original' or no role at all (§6.3).",
      "anyOf": [
        { "required": ["role"], "properties": { "role": { "const": "original" } } },
        { "not": { "required": ["role"] } }
      ]
    },
    "provenance_entry": {
      "description": "§6.4. Every key optional and informative.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "session_id": { "type": "string" },
        "original_path": { "type": "string" },
        "source_label": { "type": "string" },
        "checksum_verified_at": { "$ref": "#/$defs/nullable_datetime" },
        "note": { "type": ["string", "null"] }
      }
    },
    "media_binding": {
      "description": "§6.",
      "type": "object",
      "required": ["files"],
      "additionalProperties": true,
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" },
          "contains": { "$ref": "#/$defs/original_file" },
          "minContains": 1,
          "maxContains": 1
        },
        "timecode": {
          "oneOf": [ { "$ref": "#/$defs/timecode" }, { "type": "null" } ]
        },
        "duration_s": { "type": ["number", "null"], "minimum": 0 },
        "duration_frames": { "type": "integer", "minimum": 0 },
        "asset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "shot_at": { "$ref": "#/$defs/nullable_datetime" },
        "camera": { "type": ["string", "null"], "maxLength": 256 },
        "ingested_at": { "$ref": "#/$defs/nullable_datetime" },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance_entry" }
        }
      }
    },
    "attachment": {
      "description": "One member owned by a run (§7b). Kind-specific keys are permitted and checked by the validator.",
      "type": "object",
      "required": ["sha256", "size", "media_type"],
      "additionalProperties": true,
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$" }
      }
    },
    "signature": {
      "description": "§9.3.",
      "type": "object",
      "required": ["algorithm", "public_key", "signature"],
      "additionalProperties": true,
      "properties": {
        "role": { "type": "string" },
        "signer": { "type": "string" },
        "algorithm": { "type": "string", "const": "Ed25519" },
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed_at": { "$ref": "#/$defs/datetime" },
        "signature": {
          "type": "string",
          "description": "Standard base64 of a 64-byte Ed25519 signature: 88 characters ending in ==.",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "run": {
      "description": "One producer run (§7.2). run_id derivation, uniqueness and lineage resolution are checked by the validator.",
      "type": "object",
      "required": ["run_id", "producer", "model_version", "facets"],
      "additionalProperties": true,
      "properties": {
        "run_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "producer": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(:[a-z0-9][a-z0-9._-]{0,63})+$" },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generator": { "type": "string" },
        "generated_at": { "$ref": "#/$defs/datetime" },
        "host": {
          "description": "The class of machine the run executed on (\u00a77.2). A class, never an instance: no hostname, user name, address or serial number (\u00a713).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "os": { "type": "string", "enum": ["macos", "linux", "windows", "other"] },
            "arch": { "type": "string", "enum": ["arm64", "x86_64", "other"] },
            "accelerator": { "type": "string", "enum": ["cpu", "cuda", "metal", "rocm", "other"] }
          }
        },
        "models": {
          "description": "Model artefacts the run consumed (\u00a77.2), each naming a file and its digest.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "sha256"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "supersedes": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
        },
        "egress": { "type": "string", "enum": ["none", "derived", "frames", "full_media"] },
        "confidence_scale": { "type": "string", "enum": ["unit", "bp"] },
        "facets": { "type": "object", "additionalProperties": true },
        "attachments": {
          "type": "object",
          "patternProperties": {
            "^(embeddings|keyframes|extensions)/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$": { "$ref": "#/$defs/attachment" }
          },
          "additionalProperties": false
        },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "label": {
      "description": "One human judgement (§8.2).",
      "type": "object",
      "required": ["name", "value", "created_by"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "created_by": { "type": "string", "minLength": 1, "maxLength": 256 },
        "created_at": { "$ref": "#/$defs/datetime" },
        "span": { "$ref": "#/$defs/span" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "by": {
          "description": "Self-declared human identity (\u00a78.2). A claim, never a proof; never derived from a signature.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "at": { "$ref": "#/$defs/datetime" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "editorial_annotations": {
      "description": "The human layer (§8). Never signed. Only `labels` has a defined shape; everything else is the holder's.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/label" }
        },
        "notes": {
          "description": "Free text about the medium as a whole (\u00a78.1). Never machine-read.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
