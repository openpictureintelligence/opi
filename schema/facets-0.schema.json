    "embedding_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/entry"
        }
      ],
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "member": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "dim": {
          "type": "integer",
          "minimum": 1
        },
        "dtype": {
          "type": "string",
          "enum": [
            "F32",
            "F16",
            "BF16",
            "I8",
            "U8"
          ]
        },
        "per": {
          "type": "string",
          "enum": [
